# Flatsat tester firmware for an Adafruit Metro M4 Grand Central (ATSAMD51P20A).
# Emulates the boards missing from the flatsat and drives its analog inputs; see hil/README.md. The device models and
# command parser are in common/, separate from the board-specific code in src/.
#
# The host talks to it over SEGGER RTT through a J-Link on its SWD header (hil/lib/tester.py).
# ASF/ is generated by Atmel START from the project in tester.atzip (its configuration is also in
# atmel_start_config.atstart): load tester.atzip in START ("Load existing project"), change it there, export, and
# replace ASF/ and tester.atzip with the export (keep this Makefile and the linker script, which
# links the app above the 16 KB UF2 bootloader). Everything comes from it except the I2C targets the flatsat
# talks to (src/i2c_slave.c), which need per-byte control that ASF's I2C slave driver doesn't give.
#
#   make                                 builds tester.elf / tester.bin / tester.uf2
#   make flash JLINK_SERIAL=<serial>     flashes it through that J-Link (the UF2 bootloader below 0x4000 is kept)
#   make flash_uf2                       copies tester.uf2 to the board's UF2 drive (double-tap reset first)
#   make clean

ASF := ASF
# This repo is mounted at PVDX/flatsat-hil; the SEGGER RTT code comes from PVDX
PVDX ?= ../..
RTT := $(PVDX)/src/misc/printf
BUILD := build

CC := arm-none-eabi-gcc
OBJCOPY := arm-none-eabi-objcopy
SIZE := arm-none-eabi-size

# The UF2 bootloader's drive name; GCM4BOOT on a Grand Central
UF2_VOLUME ?= /Volumes/GCM4BOOT
# Serial number of the tester's J-Link (JLinkExe's ShowEmuList prints it); needed when two J-Links are plugged in
JLINK_SERIAL ?=

# Everything ASF/gcc/Makefile builds except its example main.c and driver examples. Wildcards, so a START export that adds
# or drops drivers needs no change here
ASF_SRCS := $(ASF)/atmel_start.c $(ASF)/driver_init.c \
            $(wildcard $(ASF)/hal/src/*.c $(ASF)/hal/utils/src/*.c $(ASF)/hpl/*/*.c) \
            $(ASF)/samd51a/gcc/gcc/startup_samd51.c $(ASF)/samd51a/gcc/system_samd51.c

SRCS := $(wildcard src/*.c) $(wildcard common/*.c) $(ASF_SRCS) $(RTT)/SEGGER_RTT.c

ASF_INCLUDES := $(ASF) $(ASF)/config $(ASF)/hal/include $(ASF)/hal/utils/include $(wildcard $(ASF)/hpl/*) $(ASF)/hri \
                $(ASF)/CMSIS/Core/Include $(ASF)/samd51a/include
INCLUDES := -Isrc -Icommon -I$(RTT) $(addprefix -I,$(ASF_INCLUDES))

# Atmel START's clock calculator works out 360 MHz for DPLL0 (GCLK2 = 1 MHz, LDR 119), although the registers it
# generates give the intended 120 MHz; the frequency constants are #ifndef-guarded, so set them right here
CLOCK_DEFINES := -DCONF_CPU_FREQUENCY=120000000 $(foreach t,0 1,-DCONF_GCLK_TCC$(t)_FREQUENCY=120000000) \
                 $(foreach t,6 7,-DCONF_GCLK_TC$(t)_FREQUENCY=120000000)

ARCH := -mthumb -mcpu=cortex-m4 -mfloat-abi=hard -mfpu=fpv4-sp-d16
CFLAGS := $(ARCH) -std=gnu99 -Os -g3 -ffunction-sections -fdata-sections -Wall -Wextra -Werror \
          -Wno-unused-parameter -D__SAMD51P20A__ $(CLOCK_DEFINES) $(INCLUDES)
# Third-party sources are built without -Wextra
LIB_CFLAGS := $(filter-out -Wextra,$(CFLAGS)) -Wno-error=cast-qual
LDFLAGS := $(ARCH) -Tsamd51p20a_tester.ld -Wl,--gc-sections -Wl,-Map=$(BUILD)/tester.map --specs=nano.specs -lm

OBJS := $(patsubst %.c,$(BUILD)/%.o,$(subst $(RTT)/,rtt/,$(SRCS)))
ASF_HEADERS := $(wildcard $(ASF)/config/*.h $(ASF)/*.h)

.PHONY: all clean flash flash_uf2
all: tester.elf tester.bin tester.uf2

$(BUILD)/src/%.o: src/%.c $(wildcard src/*.h common/*.h) $(ASF_HEADERS) Makefile
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/common/%.o: common/%.c $(wildcard common/*.h) Makefile
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/ASF/%.o: $(ASF)/%.c $(ASF_HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(LIB_CFLAGS) -c $< -o $@

$(BUILD)/rtt/%.o: $(RTT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(LIB_CFLAGS) -c $< -o $@

tester.elf: $(OBJS) samd51p20a_tester.ld
	$(CC) $(OBJS) $(LDFLAGS) -o $@
	$(SIZE) $@

tester.bin: tester.elf
	$(OBJCOPY) -O binary $< $@

tester.uf2: tester.bin tools/uf2conv.py
	python3 tools/uf2conv.py $< 0x4000 $@

flash: tester.bin
	printf 'r\nloadbin tester.bin, 0x4000\nr\ng\nexit\n' > $(BUILD)/flash.jlink
	JLinkExe $(if $(JLINK_SERIAL),-USB $(JLINK_SERIAL)) -device ATSAMD51P20A -if SWD -speed 4000 -autoconnect 1 \
		-CommanderScript $(BUILD)/flash.jlink

flash_uf2: tester.uf2
	@test -d "$(UF2_VOLUME)" || (echo "$(UF2_VOLUME) not found: double-tap the tester's reset button first" && exit 1)
	cp $< "$(UF2_VOLUME)/"

clean:
	rm -rf $(BUILD) tester.elf tester.bin tester.uf2
